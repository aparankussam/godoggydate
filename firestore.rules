rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isPartyToMatch(matchData) {
      return isSignedIn()
          && (
            request.auth.uid == matchData.dog1UserId ||
            request.auth.uid == matchData.dog2UserId ||
            request.auth.uid == matchData.userAId ||
            request.auth.uid == matchData.userBId
          );
    }

    function hasLifetimeUnlocks() {
      // Founding Member entitlement, written server-side by the Stripe webhook.
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)/private/entitlements)
          && get(/databases/$(database)/documents/users/$(request.auth.uid)/private/entitlements).data.lifetimeChatUnlocks == true;
    }

    // Soft-launch: chat is free for every real match while density is low —
    // see CHAT_FREE_LAUNCH_MODE in shared/matchAccess.ts for the full
    // rationale. Flip both this literal and that constant together; this
    // file is a separate deployable artifact and can't import the other.
    function chatFreeLaunchMode() {
      return true;
    }

    // onMatchCreatedNotify (firebase/functions) stamps chatFreeZone once,
    // right after match creation, based on both participants' neighborhood
    // density. Anything other than an explicit `false` reads as free —
    // covers matches created before this stamp existed, and the brief
    // window between match creation and the trigger completing — so a
    // stamping failure or race fails open to free chat, never to a paywall
    // the user didn't expect.
    function canCurrentUserChat(matchData) {
      // One payment (from either side) unlocks the conversation for both —
      // or, during the soft launch, no payment is required at all.
      return isSignedIn()
          && isPartyToMatch(matchData)
          && (chatFreeLaunchMode() || matchData.chatFreeZone != false || matchData.chatUnlocked == true || hasLifetimeUnlocks());
    }

    match /users/{userId} {
      allow read:   if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if false;

      // Subscription status + swipe counters live here.
      // Only the owning user can read/write their private docs —
      // except 'entitlements', which only the server (webhook) may write.
      match /private/{docId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) && docId != 'entitlements';
      }
    }

    // Fields only the server (Admin SDK, which bypasses these rules
    // entirely) may write: onDogProfileCreated assigns foundingPackNumber,
    // onRatingCreated writes trustScore/ratingCount/meetAgainRate, and the
    // Vibe Check API route writes ai. A client update() only touches the
    // keys it lists, so request.resource.data holds the previous value for
    // any of these it didn't send — this only fires if a write actually
    // tries to change one.
    function preservesServerOnlyDogFields() {
      return request.resource.data.get('foundingPackNumber', null) == resource.data.get('foundingPackNumber', null)
          && request.resource.data.get('trustScore', null)        == resource.data.get('trustScore', null)
          && request.resource.data.get('ratingCount', null)       == resource.data.get('ratingCount', null)
          && request.resource.data.get('meetAgainRate', null)     == resource.data.get('meetAgainRate', null)
          && request.resource.data.get('ai', null)                == resource.data.get('ai', null)
          // householdMemberIds only ever changes via the acceptHouseholdInvite
          // / removeHouseholdMember callables (Admin SDK, bypasses this rule
          // entirely) — never directly by the client, even the owner. A
          // direct client write would skip invite validation and the
          // HOUSEHOLD_MAX_MEMBERS cap those callables enforce.
          && request.resource.data.get('householdMemberIds', null)  == resource.data.get('householdMemberIds', null)
          && request.resource.data.get('householdMemberNames', null) == resource.data.get('householdMemberNames', null);
    }

    // On create there is no resource.data to diff against (resource doesn't
    // exist yet), so preservesServerOnlyDogFields() can't run — without this,
    // a client could set a fabricated trustScore/ratingCount/ai directly on
    // their dog's very first write, before any Cloud Function ever touches
    // it, defeating the entire point of these being server-computed.
    function hasNoServerOnlyDogFields() {
      return !('foundingPackNumber' in request.resource.data)
          && !('trustScore' in request.resource.data)
          && !('ratingCount' in request.resource.data)
          && !('meetAgainRate' in request.resource.data)
          && !('ai' in request.resource.data)
          && !('householdMemberIds' in request.resource.data)
          && !('householdMemberNames' in request.resource.data);
    }

    // True if the caller is either the dog's owner or has been granted
    // household access (invited via acceptHouseholdInvite). Used to extend
    // read/write on a dog's private subcollections — reminders today —
    // without touching the dog doc's own read rule (already public to any
    // signed-in user) or its update rule (owner-only, unaffected by this).
    function isHouseholdMember(dogId) {
      return request.auth.uid in
        get(/databases/$(database)/documents/dogs/$(dogId)).data.get('householdMemberIds', []);
    }

    match /dogs/{dogId} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn()
                    && request.auth.uid == dogId
                    && hasNoServerOnlyDogFields();
      allow update: if isSignedIn()
                    && request.auth.uid == dogId
                    && preservesServerOnlyDogFields();
      allow delete: if isSignedIn()
                    && request.auth.uid == dogId;

      // Cadence — private reminders (dose dates, licence renewal, the
      // insurance claim window). Owner OR an invited household member —
      // "did you already give her the pill" is the whole point of
      // Household, so a sitter/partner needs to actually see and complete
      // these, not just the dog's public profile. Nothing here is
      // server-computed, so no field guard is needed the way the parent doc
      // needs one for trustScore/ai/foundingPackNumber.
      match /reminders/{reminderId} {
        allow read, write: if isSignedIn()
          && (request.auth.uid == dogId || isHouseholdMember(dogId));
      }

      // Pet Twin "moments" — the AI-imagined daily cards, GROUNDED in a real
      // datum and written ONLY by the /api/ai/pet-twin route (Admin SDK,
      // bypasses these rules). Client is read-only, exactly like the guarded
      // .ai field: an LLM-authored card the browser could forge would defeat
      // the point of grounding it server-side in real state. Owner or an
      // invited household member may read; nobody writes from a client.
      match /moments/{momentId} {
        allow read: if isSignedIn()
          && (request.auth.uid == dogId || isHouseholdMember(dogId));
        allow write: if false;
      }

      // Household members' real display NAMES — moved off the world-readable
      // dog doc (any signed-in user can read that) into here, so a member's
      // real name is visible only to the owner and fellow household members.
      // householdMemberIds stays on the parent doc (the rules above depend on
      // it); only the PII names live here. Written only by the household
      // callables (Admin SDK, bypasses these rules).
      match /householdNames/{memberId} {
        allow read: if isSignedIn()
          && (request.auth.uid == dogId || isHouseholdMember(dogId));
        allow write: if false;
      }
    }

    match /swipes/{userId}/decisions/{targetDogId} {
      // Owners read their own decisions. A signed-in user may also `get` a
      // LIKE decision that targets them (doc id == their uid) — required for
      // the client-side mutual-like check that creates a match. Passes stay
      // private, and `list` stays owner-only so like-inboxes cannot be
      // enumerated. Clients must treat a denied read as "no reverse like".
      allow get: if isOwner(userId)
                 || (isSignedIn()
                     && request.auth.uid == targetDogId
                     && resource.data.action == 'like');
      allow list: if isOwner(userId);

      allow create, update: if isSignedIn()
                            && request.auth.uid == userId
                            && request.resource.data.targetUserId is string
                            && request.resource.data.action in ['like', 'pass'];

      allow delete: if false;
    }

    match /blocks/{userId}/blocked/{targetId} {
      allow read:   if isOwner(userId);
      allow create: if isOwner(userId)
                    && request.resource.data.targetUserId == targetId;
      allow update: if false;
      allow delete: if isOwner(userId);
    }

    match /matches/{matchId} {
      allow read:   if isSignedIn() && isPartyToMatch(resource.data);
      allow create: if isSignedIn()
                    && request.resource.data.dog1UserId is string
                    && request.resource.data.dog2UserId is string
                    && request.resource.data.dog1Id == request.resource.data.dog1UserId
                    && request.resource.data.dog2Id == request.resource.data.dog2UserId
                    && request.resource.data.chatUnlocked == false
                    && request.resource.data.dog1ChatUnlocked == false
                    && request.resource.data.dog2ChatUnlocked == false
                    // chatFreeZone is server-stamped by onMatchCreatedNotify right
                    // after creation — a client setting it at create time could
                    // hand itself a permanent free pass once density gating is on.
                    && !request.resource.data.keys().hasAny(['paymentId', 'chatFreeZone'])
                    && exists(/databases/$(database)/documents/swipes/$(request.resource.data.dog1UserId)/decisions/$(request.resource.data.dog2Id))
                    && exists(/databases/$(database)/documents/swipes/$(request.resource.data.dog2UserId)/decisions/$(request.resource.data.dog1Id))
                    && get(/databases/$(database)/documents/swipes/$(request.resource.data.dog1UserId)/decisions/$(request.resource.data.dog2Id)).data.action == 'like'
                    && get(/databases/$(database)/documents/swipes/$(request.resource.data.dog2UserId)/decisions/$(request.resource.data.dog1Id)).data.action == 'like'
                    && (
                         request.auth.uid == request.resource.data.dog1UserId ||
                         request.auth.uid == request.resource.data.dog2UserId
                       );
      allow update: if isSignedIn()
                    && isPartyToMatch(resource.data)
                    && canCurrentUserChat(resource.data)
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly([
                           'lastMessage',
                           'lastMessageTime',
                           'lastMessageFromUid',
                           'dog1LastReadAt',
                           'dog2LastReadAt'
                         ]);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isSignedIn()
                    && exists(/databases/$(database)/documents/matches/$(matchId))
                    && isPartyToMatch(get(/databases/$(database)/documents/matches/$(matchId)).data)
                    && canCurrentUserChat(get(/databases/$(database)/documents/matches/$(matchId)).data);

        allow create: if isSignedIn()
                      && request.resource.data.fromUserId == request.auth.uid
                      && exists(/databases/$(database)/documents/matches/$(matchId))
                      && isPartyToMatch(get(/databases/$(database)/documents/matches/$(matchId)).data)
                      && canCurrentUserChat(get(/databases/$(database)/documents/matches/$(matchId)).data);

        allow update: if false;
        allow delete: if false;
      }
    }

    match /counters/{counterId} {
      // Public, non-sensitive aggregate (e.g. Founding Pack enrollment
      // count) — powers the live counter on the homepage. Only the
      // Cloud Function (admin SDK, bypasses rules) ever writes it.
      allow read:  if true;
      allow write: if false;
    }

    match /zipDensity/{zip} {
      // Per-ZIP active-dog count, maintained by onPrivateDogProfileWrite and
      // read by onMatchCreatedNotify (both admin SDK, bypass rules). Unlike
      // counters/ above, this is never client-readable: a ZIP code is
      // exactly the private location signal the rest of this file goes out
      // of its way never to expose (see the public dogs/{dogId} rule below).
      allow read, write: if false;
    }

    // Ratings feed the trust score that onRatingCreated aggregates onto
    // dogs/{dogId}. The previous rule was forgeable in several independent
    // ways: {ratingId} was unconstrained (so the duplicate-check looked at a
    // DIFFERENT path than the doc being written), matchId was an arbitrary
    // client string, nothing required the rater to be party to the match,
    // dogId was attacker-chosen, and stars was unvalidated — so any account
    // could mint unlimited five-star self-ratings or bury another user's
    // score. Every clause below closes one of those.
    match /ratings/{ratingId} {
      // Aggregate trust is shown publicly; individual ratings are not, so a
      // rater can only read their own row back (used by hasRatedPlaydate).
      allow read:   if isSignedIn()
                    && resource.data.raterId == request.auth.uid;

      allow create: if isSignedIn()
                    // The doc id must BE the canonical id. This is what makes
                    // one-rating-per-rater-per-match actually enforceable:
                    // Firestore rejects a create on an existing doc, so
                    // pinning the id removes the need for an exists() check
                    // and closes the random-id bypass at the same time.
                    && ratingId == request.auth.uid + '_' + request.resource.data.matchId
                    && request.resource.data.raterId == request.auth.uid
                    // Must actually be a participant in the match being rated.
                    && isPartyToMatch(
                         get(/databases/$(database)/documents/matches/$(request.resource.data.matchId)).data
                       )
                    // Can only rate the OTHER dog, never yourself.
                    && request.resource.data.dogId != request.auth.uid
                    && request.resource.data.dogId in [
                         get(/databases/$(database)/documents/matches/$(request.resource.data.matchId)).data.dog1UserId,
                         get(/databases/$(database)/documents/matches/$(request.resource.data.matchId)).data.dog2UserId
                       ]
                    // Bound the numbers the trust aggregation multiplies.
                    && request.resource.data.stars is int
                    && request.resource.data.stars >= 1
                    && request.resource.data.stars <= 5
                    && request.resource.data.wouldMeetAgain is bool;

      allow update: if false;
      allow delete: if false;
    }

    match /payments/{paymentId} {
      allow read:   if isSignedIn()
                    && resource.data.userId == request.auth.uid;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    match /matchUnlocks/{unlockId} {
      allow read, create, update, delete: if false;
    }

    match /stripeEvents/{eventId} {
      allow read, create, update, delete: if false;
    }

    // Household invite codes — entirely server-mediated (createHouseholdInvite
    // / acceptHouseholdInvite, both Admin SDK). No direct client read: an
    // invite code readable by anyone who could `get` this doc would let a
    // client enumerate or brute-force codes instead of the server validating
    // one at a time.
    match /householdInvites/{code} {
      allow read, create, update, delete: if false;
    }

    match /reports/{reportId} {
      allow create: if isSignedIn()
                    && request.resource.data.reporterId == request.auth.uid;
      allow read:   if false;
      allow update: if false;
      allow delete: if false;
    }
  }
}
