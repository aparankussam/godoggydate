rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // A real account: signed in with Google or Apple, as opposed to an
    // anonymous guest (the iPhone app's guest mode) or any other provider.
    // Creating a dog profile needs one, so a throwaway anonymous account can't
    // fill the database with hollow dogs or take a free Founding spot. A guest
    // who links Google or Apple gets a new token whose sign_in_provider is the
    // linked provider, and can then create the profile.
    function isRealAccount() {
      return isSignedIn()
          && request.auth.token.firebase.sign_in_provider in ['google.com', 'apple.com'];
    }

    // ── Shape helpers ─────────────────────────────────────────────────────────
    // Rules can't loop, so list contents are bounded with size() and join(), or
    // checked by index for the short lists. null passes everything: the apps
    // write null to clear a field ({ merge: true } saves) and a legacy doc may
    // simply lack it. These limits sit above the apps' own (PROFILE_TEXT_LIMITS
    // in shared/profileInput.ts) so no real profile is refused; they exist so a
    // modified client can't store a 900 KB name or a thousand photo URLs on a
    // document every signed-in user reads.
    function okStr(v, max) {
      return v == null || (v is string && v.size() <= max);
    }

    function okNum(v) {
      return v == null || v is number;
    }

    function okBool(v) {
      return v == null || v is bool;
    }

    // At most maxItems entries and maxChars characters in all.
    function okStrList(v, maxItems, maxChars) {
      return v == null
          || (v is list && v.size() <= maxItems && v.join('').size() <= maxChars);
    }

    // Entry i of a list is a string of at most max characters (or there is no entry i).
    function okStrAt(v, i, max) {
      return v.size() <= i || (v[i] is string && v[i].size() <= max);
    }

    // photos: up to 6 entries (MAX_PHOTOS in the profile form), each a string
    // of at most 1000 characters. A real Storage download URL is ~300.
    function okPhotos(v) {
      return v == null
          || (v is list && v.size() <= 6
              && okStrAt(v, 0, 1000) && okStrAt(v, 1, 1000) && okStrAt(v, 2, 1000)
              && okStrAt(v, 3, 1000) && okStrAt(v, 4, 1000) && okStrAt(v, 5, 1000));
    }

    // prompts: up to 6 { prompt, answer } maps; answers are capped at 300 in
    // both apps (PROFILE_TEXT_LIMITS.promptAnswer).
    function okPromptAt(v, i) {
      return v.size() <= i
          || (v[i] is map && okStr(v[i].get('prompt', null), 200) && okStr(v[i].get('answer', null), 300));
    }

    function okPrompts(v) {
      return v == null
          || (v is list && v.size() <= 6
              && okPromptAt(v, 0) && okPromptAt(v, 1) && okPromptAt(v, 2)
              && okPromptAt(v, 3) && okPromptAt(v, 4) && okPromptAt(v, 5));
    }

    // The owner-writable fields of a dog document. Not a whitelist on purpose:
    // new fields ship with the apps (publicPage was the last), and a whitelist
    // here would silently refuse every profile save until the rules caught up.
    // Fields that aren't listed are limited only by the key count and by the
    // 1 MiB document cap.
    function validDogShape(d) {
      return d.keys().size() <= 60
          && okStr(d.get('name', null), 60)
          && okStr(d.get('breed', null), 80)
          && okStr(d.get('bio', null), 1000)
          && okStr(d.get('healthNotes', null), 1000)
          && okStr(d.get('city', null), 80)
          && okStr(d.get('state', null), 40)
          && okStr(d.get('location', null), 160)
          && okStr(d.get('age', null), 20)
          && okStr(d.get('sex', null), 20)
          && okStr(d.get('size', null), 20)
          && okStr(d.get('ownerId', null), 128)
          && okStr(d.get('rabiesExpiry', null), 32)
          && okStr(d.get('adoptionDate', null), 32)
          && okStr(d.get('bestFriendMatchId', null), 200)
          && okNum(d.get('energyLevel', null))
          && okNum(d.get('lat', null))
          && okNum(d.get('lng', null))
          && okNum(d.get('birthYear', null))
          && okNum(d.get('birthMonth', null))
          && okNum(d.get('birthDay', null))
          && okNum(d.get('coverPhotoIndex', null))
          && okNum(d.get('coverFocusX', null))
          && okNum(d.get('coverFocusY', null))
          && okBool(d.get('vaccinated', null))
          && okBool(d.get('publicPage', null))
          && okPhotos(d.get('photos', null))
          && okPrompts(d.get('prompts', null))
          && okStrList(d.get('temperament', null), 12, 720)
          && okStrList(d.get('playStyles', null), 12, 720)
          && okStrList(d.get('notGoodWith', null), 12, 720)
          && okStrList(d.get('behaviorFlags', null), 12, 720)
          && okStrList(d.get('goodWith', null), 12, 720)
          && okStrList(d.get('boundaries', null), 12, 720)
          && okStrList(d.get('allergies', null), 12, 720)
          && okStrList(d.get('specialNeeds', null), 12, 720);
    }

    function isPartyToMatch(matchData) {
      return isSignedIn()
          && (
            request.auth.uid == matchData.dog1UserId ||
            request.auth.uid == matchData.dog2UserId ||
            request.auth.uid == matchData.userAId ||
            request.auth.uid == matchData.userBId
          );
    }

    function hasLifetimeUnlocks() {
      // Founding Member entitlement, written server-side by the Stripe webhook.
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)/private/entitlements)
          && get(/databases/$(database)/documents/users/$(request.auth.uid)/private/entitlements).data.lifetimeChatUnlocks == true;
    }

    // Soft-launch: chat is free for every real match while density is low —
    // see CHAT_FREE_LAUNCH_MODE in shared/matchAccess.ts for the full
    // rationale. Flip both this literal and that constant together; this
    // file is a separate deployable artifact and can't import the other.
    function chatFreeLaunchMode() {
      return true;
    }

    // onMatchCreatedNotify (firebase/functions) stamps chatFreeZone once,
    // right after match creation, based on both participants' neighborhood
    // density. Anything other than an explicit `false` reads as free —
    // covers matches created before this stamp existed, and the brief
    // window between match creation and the trigger completing — so a
    // stamping failure or race fails open to free chat, never to a paywall
    // the user didn't expect.
    function canCurrentUserChat(matchData) {
      // One payment (from either side) unlocks the conversation for both —
      // or, during the soft launch, no payment is required at all.
      return isSignedIn()
          && isPartyToMatch(matchData)
          && (chatFreeLaunchMode() || matchData.chatFreeZone != false || matchData.chatUnlocked == true || hasLifetimeUnlocks());
    }

    // A playdate card on a message: only the three fields both apps write, each a
    // short string. `text` is capped at 1000 but this map used to be unbounded, so a
    // modified client could post a card with a megabyte "place" that every
    // participant's chat then had to render.
    function validPlaydate(p) {
      return p is map
          && p.keys().hasOnly(['date', 'time', 'place'])
          && p.get('date', '') is string && p.get('date', '').size() <= 200
          && p.get('time', '') is string && p.get('time', '').size() <= 200
          && p.get('place', '') is string && p.get('place', '').size() <= 200;
    }

    // Symmetric, so it never needs to know which side the caller is on.
    function isBlockedEitherWay(uidA, uidB) {
      return exists(/databases/$(database)/documents/blocks/$(uidA)/blocked/$(uidB))
          || exists(/databases/$(database)/documents/blocks/$(uidB)/blocked/$(uidA));
    }

    // users/{uid} holds the terms acceptance (termsAcceptedAt, termsVersion,
    // ageConfirmed18). Capped by key count and the known strings; see validDogShape
    // for why it isn't a whitelist.
    function validUserDocShape(d) {
      return d.keys().size() <= 30
          && okStr(d.get('termsVersion', null), 40)
          && okBool(d.get('ageConfirmed18', null));
    }

    // The owner's own private documents. dogProfile carries the real location
    // (ZIP, city, state, coordinates); push carries the device tokens.
    function validPrivateDocShape(docId, d) {
      return d.keys().size() <= 40
          && (docId != 'dogProfile'
              || (okStr(d.get('zip', null), 10)
                  && okStr(d.get('city', null), 80)
                  && okStr(d.get('state', null), 40)
                  && okStr(d.get('location', null), 160)
                  && okNum(d.get('lat', null))
                  && okNum(d.get('lng', null))))
          && (docId != 'push'
              || (okStrList(d.get('expoPushTokens', null), 50, 15000)
                  && okStrList(d.get('fcmWebTokens', null), 50, 15000)))
          && (docId != 'lostKit' || validLostKit(d));
    }

    match /users/{userId} {
      allow read:   if isOwner(userId);
      allow create: if isOwner(userId) && validUserDocShape(request.resource.data);
      allow update: if isOwner(userId) && validUserDocShape(request.resource.data);
      allow delete: if false;

      // Subscription status + swipe counters live here.
      // Only the owning user can read/write their private docs —
      // except 'entitlements', which only the server (webhook) may write.
      match /private/{docId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
                              && docId != 'entitlements'
                              && validPrivateDocShape(docId, request.resource.data);
        allow delete: if isOwner(userId) && docId != 'entitlements';
      }
    }

    // Fields only the server (Admin SDK, which bypasses these rules
    // entirely) may write: onDogProfileFounding assigns foundingPackNumber,
    // onRatingCreated writes trustScore/ratingCount/meetAgainRate, and the
    // Vibe Check API route writes ai. A client update() only touches the
    // keys it lists, so request.resource.data holds the previous value for
    // any of these it didn't send — this only fires if a write actually
    // tries to change one.
    function preservesServerOnlyDogFields() {
      return request.resource.data.get('foundingPackNumber', null) == resource.data.get('foundingPackNumber', null)
          && request.resource.data.get('trustScore', null)        == resource.data.get('trustScore', null)
          && request.resource.data.get('ratingCount', null)       == resource.data.get('ratingCount', null)
          && request.resource.data.get('meetAgainRate', null)     == resource.data.get('meetAgainRate', null)
          && request.resource.data.get('ai', null)                == resource.data.get('ai', null)
          // householdMemberIds only ever changes via the acceptHouseholdInvite
          // / removeHouseholdMember callables (Admin SDK, bypasses this rule
          // entirely) — never directly by the client, even the owner. A
          // direct client write would skip invite validation and the
          // HOUSEHOLD_MAX_MEMBERS cap those callables enforce.
          && request.resource.data.get('householdMemberIds', null)  == resource.data.get('householdMemberIds', null)
          && request.resource.data.get('householdMemberNames', null) == resource.data.get('householdMemberNames', null);
    }

    // On create there is no resource.data to diff against (resource doesn't
    // exist yet), so preservesServerOnlyDogFields() can't run — without this,
    // a client could set a fabricated trustScore/ratingCount/ai directly on
    // their dog's very first write, before any Cloud Function ever touches
    // it, defeating the entire point of these being server-computed.
    function hasNoServerOnlyDogFields() {
      return !('foundingPackNumber' in request.resource.data)
          && !('trustScore' in request.resource.data)
          && !('ratingCount' in request.resource.data)
          && !('meetAgainRate' in request.resource.data)
          && !('ai' in request.resource.data)
          && !('householdMemberIds' in request.resource.data)
          && !('householdMemberNames' in request.resource.data);
    }

    // True if the caller is either the dog's owner or has been granted
    // household access (invited via acceptHouseholdInvite). Used to extend
    // read/write on a dog's private subcollections — reminders today —
    // without touching the dog doc's own read rule (already public to any
    // signed-in user) or its update rule (owner-only, unaffected by this).
    function isHouseholdMember(dogId) {
      return request.auth.uid in
        get(/databases/$(database)/documents/dogs/$(dogId)).data.get('householdMemberIds', []);
    }

    match /dogs/{dogId} {
      allow read:   if isSignedIn();
      // Creating the profile needs a Google or Apple account (isRealAccount):
      // anonymous guests can browse but not make a profile. A Founding number
      // is also only awarded to a finished profile (onDogProfileFounding).
      allow create: if isRealAccount()
                    && request.auth.uid == dogId
                    && hasNoServerOnlyDogFields()
                    && validDogShape(request.resource.data);
      allow update: if isSignedIn()
                    && request.auth.uid == dogId
                    && preservesServerOnlyDogFields()
                    && validDogShape(request.resource.data);
      allow delete: if isSignedIn()
                    && request.auth.uid == dogId;

      // Cadence — private reminders (dose dates, licence renewal, the
      // insurance claim window). Owner OR an invited household member —
      // "did you already give her the pill" is the whole point of
      // Household, so a sitter/partner needs to actually see and complete
      // these, not just the dog's public profile. Nothing here is
      // server-computed, so no field guard is needed the way the parent doc
      // needs one for trustScore/ai/foundingPackNumber.
      match /reminders/{reminderId} {
        allow read, delete: if isSignedIn()
          && (request.auth.uid == dogId || isHouseholdMember(dogId));
        allow create, update: if isSignedIn()
          && (request.auth.uid == dogId || isHouseholdMember(dogId))
          && request.resource.data.keys().size() <= 15
          && okStr(request.resource.data.get('label', null), 200)
          && okStr(request.resource.data.get('type', null), 40)
          && okNum(request.resource.data.get('recurrenceDays', null))
          && okNum(request.resource.data.get('currentStreak', null));
      }

      // Pet Twin "moments" — the AI-imagined daily cards, GROUNDED in a real
      // datum and written ONLY by the /api/ai/pet-twin route (Admin SDK,
      // bypasses these rules). Client is read-only, exactly like the guarded
      // .ai field: an LLM-authored card the browser could forge would defeat
      // the point of grounding it server-side in real state. Owner or an
      // invited household member may read; nobody writes from a client.
      match /moments/{momentId} {
        allow read: if isSignedIn()
          && (request.auth.uid == dogId || isHouseholdMember(dogId));
        allow write: if false;
      }

      // Household members' real display NAMES — moved off the world-readable
      // dog doc (any signed-in user can read that) into here, so a member's
      // real name is visible only to the owner and fellow household members.
      // householdMemberIds stays on the parent doc (the rules above depend on
      // it); only the PII names live here. Written only by the household
      // callables (Admin SDK, bypasses these rules).
      match /householdNames/{memberId} {
        allow read: if isSignedIn()
          && (request.auth.uid == dogId || isHouseholdMember(dogId));
        allow write: if false;
      }
    }

    match /swipes/{userId}/decisions/{targetDogId} {
      // Owners read their own decisions. A signed-in user may also `get` a
      // LIKE decision that targets them (doc id == their uid) — required for
      // the client-side mutual-like check that creates a match. Passes stay
      // private, and `list` stays owner-only so like-inboxes cannot be
      // enumerated. Clients must treat a denied read as "no reverse like".
      allow get: if isOwner(userId)
                 || (isSignedIn()
                     && request.auth.uid == targetDogId
                     && resource.data.action == 'like');
      allow list: if isOwner(userId);

      // Exactly what both apps write (web: action, timestamp, targetUserId;
      // iPhone adds targetDogId). The ids are Firestore document ids.
      allow create, update: if isSignedIn()
                            && request.auth.uid == userId
                            && request.resource.data.keys().hasOnly(['action', 'timestamp', 'targetUserId', 'targetDogId'])
                            && request.resource.data.targetUserId is string
                            && request.resource.data.targetUserId.size() <= 128
                            && okStr(request.resource.data.get('targetDogId', null), 128)
                            && request.resource.data.action in ['like', 'pass'];

      allow delete: if false;
    }

    match /blocks/{userId}/blocked/{targetId} {
      allow read:   if isOwner(userId);
      allow create: if isOwner(userId)
                    && request.resource.data.keys().hasOnly(['targetUserId', 'createdAt'])
                    && request.resource.data.targetUserId == targetId;
      allow update: if false;
      allow delete: if isOwner(userId);
    }

    // Written only by the onBlockWrite function. Lets the blocked person's own
    // feed hide the blocker without exposing the blocker's list.
    match /blocks/{userId}/blockedBy/{blockerId} {
      allow read:  if isOwner(userId);
      allow write: if false;
    }

    match /matches/{matchId} {
      allow read:   if isSignedIn() && isPartyToMatch(resource.data);
      allow create: if isSignedIn()
                    // Exactly what both clients write. Without this a creator
                    // could add userAId/userBId, which isPartyToMatch trusts,
                    // and let a third person read the thread.
                    && request.resource.data.keys().hasOnly([
                         'dog1Id', 'dog2Id', 'dog1UserId', 'dog2UserId',
                         'chatUnlocked', 'dog1ChatUnlocked', 'dog2ChatUnlocked',
                         'createdAt', 'lastMessage', 'lastMessageTime', 'lastMessageFromUid',
                         'dog1LastReadAt', 'dog2LastReadAt'
                       ])
                    // One pair, one match: otherwise a single mutual like could
                    // mint unlimited match docs, each sending a push.
                    && matchId == request.resource.data.dog1UserId + '_' + request.resource.data.dog2UserId
                    && request.resource.data.dog1UserId < request.resource.data.dog2UserId
                    && !isBlockedEitherWay(request.resource.data.dog1UserId, request.resource.data.dog2UserId)
                    && request.resource.data.dog1UserId is string
                    && request.resource.data.dog2UserId is string
                    && request.resource.data.dog1Id == request.resource.data.dog1UserId
                    && request.resource.data.dog2Id == request.resource.data.dog2UserId
                    && request.resource.data.chatUnlocked == false
                    && request.resource.data.dog1ChatUnlocked == false
                    && request.resource.data.dog2ChatUnlocked == false
                    // chatFreeZone is server-stamped by onMatchCreatedNotify right
                    // after creation — a client setting it at create time could
                    // hand itself a permanent free pass once density gating is on.
                    && !request.resource.data.keys().hasAny(['paymentId', 'chatFreeZone'])
                    && exists(/databases/$(database)/documents/swipes/$(request.resource.data.dog1UserId)/decisions/$(request.resource.data.dog2Id))
                    && exists(/databases/$(database)/documents/swipes/$(request.resource.data.dog2UserId)/decisions/$(request.resource.data.dog1Id))
                    && get(/databases/$(database)/documents/swipes/$(request.resource.data.dog1UserId)/decisions/$(request.resource.data.dog2Id)).data.action == 'like'
                    && get(/databases/$(database)/documents/swipes/$(request.resource.data.dog2UserId)/decisions/$(request.resource.data.dog1Id)).data.action == 'like'
                    && (
                         request.auth.uid == request.resource.data.dog1UserId ||
                         request.auth.uid == request.resource.data.dog2UserId
                       );
      allow update: if isSignedIn()
                    && isPartyToMatch(resource.data)
                    && canCurrentUserChat(resource.data)
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly([
                           'lastMessage',
                           'lastMessageTime',
                           'lastMessageFromUid',
                           'dog1LastReadAt',
                           'dog2LastReadAt'
                         ]);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isSignedIn()
                    && exists(/databases/$(database)/documents/matches/$(matchId))
                    && isPartyToMatch(get(/databases/$(database)/documents/matches/$(matchId)).data)
                    && canCurrentUserChat(get(/databases/$(database)/documents/matches/$(matchId)).data);

        allow create: if isSignedIn()
                      && request.resource.data.fromUserId == request.auth.uid
                      && request.resource.data.keys().hasOnly([
                           'text', 'fromUserId', 'senderId', 'isSystem', 'read',
                           'createdAt', 'type', 'playdate'
                         ])
                      && request.resource.data.text is string
                      && request.resource.data.text.size() <= 1000
                      && okStr(request.resource.data.get('senderId', null), 128)
                      && okBool(request.resource.data.get('read', null))
                      && (!('type' in request.resource.data)
                          || request.resource.data.type in ['playdate_proposal', 'playdate_confirmed'])
                      && (!('playdate' in request.resource.data)
                          || validPlaydate(request.resource.data.playdate))
                      // System banners are styled as coming from the app itself.
                      && request.resource.data.get('isSystem', false) == false
                      && !isBlockedEitherWay(
                           get(/databases/$(database)/documents/matches/$(matchId)).data.dog1UserId,
                           get(/databases/$(database)/documents/matches/$(matchId)).data.dog2UserId
                         )
                      && exists(/databases/$(database)/documents/matches/$(matchId))
                      && isPartyToMatch(get(/databases/$(database)/documents/matches/$(matchId)).data)
                      && canCurrentUserChat(get(/databases/$(database)/documents/matches/$(matchId)).data);

        allow update: if false;
        allow delete: if false;
      }
    }

    match /counters/{counterId} {
      // Public, non-sensitive aggregate (e.g. Founding Pack enrollment
      // count) — powers the live counter on the homepage. Only the
      // Cloud Function (admin SDK, bypasses rules) ever writes it.
      allow read:  if true;
      allow write: if false;
    }

    match /zipDensity/{zip} {
      // Per-ZIP active-dog count, maintained by onPrivateDogProfileWrite and
      // read by onMatchCreatedNotify (both admin SDK, bypass rules). Unlike
      // counters/ above, this is never client-readable: a ZIP code is
      // exactly the private location signal the rest of this file goes out
      // of its way never to expose (see the public dogs/{dogId} rule below).
      allow read, write: if false;
    }

    // Ratings feed the trust score that onRatingCreated aggregates onto
    // dogs/{dogId}. The previous rule was forgeable in several independent
    // ways: {ratingId} was unconstrained (so the duplicate-check looked at a
    // DIFFERENT path than the doc being written), matchId was an arbitrary
    // client string, nothing required the rater to be party to the match,
    // dogId was attacker-chosen, and stars was unvalidated — so any account
    // could mint unlimited five-star self-ratings or bury another user's
    // score. Every clause below closes one of those.
    match /ratings/{ratingId} {
      // Aggregate trust is shown publicly; individual ratings are not, so a
      // rater can only read their own row back (used by hasRatedPlaydate).
      allow read:   if isSignedIn()
                    && resource.data.raterId == request.auth.uid;

      allow create: if isSignedIn()
                    // The doc id must BE the canonical id. This is what makes
                    // one-rating-per-rater-per-match actually enforceable:
                    // Firestore rejects a create on an existing doc, so
                    // pinning the id removes the need for an exists() check
                    // and closes the random-id bypass at the same time.
                    && ratingId == request.auth.uid + '_' + request.resource.data.matchId
                    && request.resource.data.raterId == request.auth.uid
                    // Must actually be a participant in the match being rated.
                    && isPartyToMatch(
                         get(/databases/$(database)/documents/matches/$(request.resource.data.matchId)).data
                       )
                    // Can only rate the OTHER dog, never yourself.
                    && request.resource.data.dogId != request.auth.uid
                    && request.resource.data.dogId in [
                         get(/databases/$(database)/documents/matches/$(request.resource.data.matchId)).data.dog1UserId,
                         get(/databases/$(database)/documents/matches/$(request.resource.data.matchId)).data.dog2UserId
                       ]
                    // Bound the numbers the trust aggregation multiplies.
                    && request.resource.data.stars is int
                    && request.resource.data.stars >= 1
                    && request.resource.data.stars <= 5
                    && request.resource.data.wouldMeetAgain is bool
                    && request.resource.data.matchId is string
                    && request.resource.data.matchId.size() <= 128
                    && request.resource.data.keys().size() <= 10;

      allow update: if false;
      allow delete: if false;
    }

    // Pack Day — open group playdates at a public place. Members can read
    // events and see who is going (the same dogs/{uid} docs are already readable
    // by any signed-in member). Every write — creating, joining, leaving,
    // cancelling — goes through the createPackDay / rsvpPackDay / cancelPackDay
    // callables, which enforce capacity, per-member limits and blocks
    // atomically and are the only place `official` can ever be set. Anonymous
    // visitors see a counts-only public page rendered server-side via the Admin
    // SDK, so no public read rule is needed here.
    match /packDays/{eventId} {
      allow read:  if isSignedIn();
      allow write: if false;
    }

    // ── Pack Day check-ins (packDays/{eventId}/checkins/{uid}) ───────────────
    // One doc per person who tapped "I'm here": { uid, dogId, at, method }.
    // Create only: the signed-in person writes their OWN doc (docId == uid),
    // for a dog that RSVP'd (dogId is in attendeeUids) and is theirs or one
    // they share through the household, on an open event, from 30 minutes
    // before the start until it ends (CHECKIN_OPENS_BEFORE_MS in
    // shared/packDay.ts = 1800000). `at` must be the server time. No client
    // update or delete. Members may read, to show the checked-in count.
    match /packDays/{eventId}/checkins/{uid} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(['uid', 'dogId', 'at', 'method'])
                    && request.resource.data.keys().hasAll(['uid', 'dogId', 'at', 'method'])
                    && request.resource.data.uid == uid
                    && request.resource.data.dogId is string
                    && request.resource.data.method in ['qr', 'location']
                    && request.resource.data.at == request.time
                    && (request.resource.data.dogId == uid || isHouseholdMember(request.resource.data.dogId))
                    && get(/databases/$(database)/documents/packDays/$(eventId)).data.status == 'open'
                    && request.resource.data.dogId in get(/databases/$(database)/documents/packDays/$(eventId)).data.attendeeUids
                    && request.time.toMillis() >= get(/databases/$(database)/documents/packDays/$(eventId)).data.startsAtMs - 1800000
                    && request.time.toMillis() < get(/databases/$(database)/documents/packDays/$(eventId)).data.startsAtMs
                                                 + get(/databases/$(database)/documents/packDays/$(eventId)).data.durationMinutes * 60000;
      allow update, delete: if false;
    }

    // ── PACK DAY GROUP CHAT ───────────────────────────────────────────────────
    // packDays/{eventId}/messages and packDays/{eventId}/chatControl/state.
    // Members are the event's RSVP list (attendeeUids), so RSVPing opens the
    // chat and leaving or being removed closes it. The chat turns READ-ONLY 48
    // hours after the event ENDS: the end is startsAtMs + durationMinutes, read
    // from the event doc, so a client can't talk past it (CHAT_READ_ONLY_AFTER_MS
    // in shared/packDayChat.ts is the same 48 hours). A cancelled event is
    // read-only at once. chatControl/state ({ pinned, mutedUids, removedUids })
    // is written only by the packDayChatHost callable, which is also what removes
    // a member. The morning-of 'headsup' post and moderation (text replaced,
    // moderated: true) are Admin writes; clients never update or delete.
    function isPackDayMember(eventId) {
      return isSignedIn()
          && exists(/databases/$(database)/documents/packDays/$(eventId))
          && request.auth.uid in get(/databases/$(database)/documents/packDays/$(eventId)).data.attendeeUids;
    }

    function packDayChatOpen(eventId) {
      let e = get(/databases/$(database)/documents/packDays/$(eventId)).data;
      return e.status == 'open'
          && request.time.toMillis() < e.startsAtMs + e.durationMinutes * 60000 + 172800000;
    }

    function packDayChatMuted(eventId) {
      let c = /databases/$(database)/documents/packDays/$(eventId)/chatControl/state;
      return exists(c) && request.auth.uid in get(c).data.get('mutedUids', []);
    }

    match /packDays/{eventId}/chatControl/{docId} {
      allow read:  if isPackDayMember(eventId);
      allow write: if false;
    }

    match /packDays/{eventId}/messages/{messageId} {
      allow read: if isPackDayMember(eventId);

      allow create: if isPackDayMember(eventId)
                    && packDayChatOpen(eventId)
                    && !packDayChatMuted(eventId)
                    && request.resource.data.keys().hasOnly(['fromUserId', 'text', 'kind', 'photoUrl', 'createdAt'])
                    && request.resource.data.keys().hasAll(['fromUserId', 'text', 'kind', 'createdAt'])
                    && request.resource.data.fromUserId == request.auth.uid
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.text is string
                    && request.resource.data.text.size() <= 500
                    && request.resource.data.kind in ['text', 'here', 'late', 'headsup', 'photo']
                    // Only the host posts the weather check.
                    && (request.resource.data.kind != 'headsup'
                        || request.auth.uid == get(/databases/$(database)/documents/packDays/$(eventId)).data.hostUid)
                    && (request.resource.data.kind != 'text' || request.resource.data.text.size() > 0)
                    // Photos: a real https URL, and only once the event has started.
                    && (request.resource.data.kind == 'photo'
                        ? (request.resource.data.get('photoUrl', null) is string
                           && request.resource.data.photoUrl.size() <= 1000
                           && request.resource.data.photoUrl.matches('https://.*')
                           && request.time.toMillis() >= get(/databases/$(database)/documents/packDays/$(eventId)).data.startsAtMs)
                        : !('photoUrl' in request.resource.data));

      allow update, delete: if false;
    }

    match /payments/{paymentId} {
      allow read:   if isSignedIn()
                    && resource.data.userId == request.auth.uid;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    match /matchUnlocks/{unlockId} {
      allow read, create, update, delete: if false;
    }

    match /stripeEvents/{eventId} {
      allow read, create, update, delete: if false;
    }

    // Household invite codes — entirely server-mediated (createHouseholdInvite
    // / acceptHouseholdInvite, both Admin SDK). No direct client read: an
    // invite code readable by anyone who could `get` this doc would let a
    // client enumerate or brute-force codes instead of the server validating
    // one at a time.
    match /householdInvites/{code} {
      allow read, create, update, delete: if false;
    }

    // A report is read only by the server (onReportCreated copies the evidence and
    // alerts ops), so the caps are about cost and abuse, not display. The
    // free-text fields listed are the ones a report form could carry.
    match /reports/{reportId} {
      allow create: if isSignedIn()
                    && request.resource.data.reporterId == request.auth.uid
                    && request.resource.data.targetUserId is string
                    && request.resource.data.targetUserId.size() <= 128
                    && request.resource.data.reason is string
                    && request.resource.data.reason.size() <= 100
                    && request.resource.data.keys().size() <= 12
                    && okStr(request.resource.data.get('source', null), 60)
                    && okStr(request.resource.data.get('matchId', null), 128)
                    && okStr(request.resource.data.get('eventId', null), 128)
                    // A single Pack Day chat message being reported (with eventId).
                    && okStr(request.resource.data.get('messageId', null), 128)
                    && okStr(request.resource.data.get('text', null), 1000)
                    && okStr(request.resource.data.get('details', null), 1000)
                    && okStr(request.resource.data.get('note', null), 1000)
                    && okStr(request.resource.data.get('comment', null), 1000)
                    && okStr(request.resource.data.get('message', null), 1000);
      allow read:   if false;
      allow update: if false;
      allow delete: if false;
    }

    // ══ LOST DOG ALERT ════════════════════════════════════════════════════════
    // Free for everyone. Three collections, all owned by the lost-dog feature:
    //   users/{uid}/private/lostKit      the owner's saved kit (microchip, vet phone);
    //                                    covered by the private/{docId} rule above
    //   lostAlerts/{alertId}             the public-safe alert (never a phone number
    //                                    or address); sightings/ under it are owner-only
    //   lostActive/{uid}                 pointer that makes "ONE active alert per owner"
    //                                    a rule, not just a UI habit
    // The same limits are re-checked server-side by onLostAlertCreated
    // (firebase/functions/src/lostDog.ts). Sightings and rate counters are written
    // only by the Admin SDK (the website's /api/lost/sighting route).

    function validLostKit(d) {
      return d.keys().size() <= 8
          && okStr(d.get('photoUrl', null), 1000)
          && okStr(d.get('microchip', null), 40)
          && okStr(d.get('vetPhone', null), 30)
          && okStr(d.get('markings', null), 200);
    }

    // A new alert: the caller's own dog (the dog doc id is the owner's uid),
    // active, with only the public-safe fields. city/state are re-stamped from the
    // dog profile by the server, so what is sent here is only a first draft.
    function validNewLostAlert(d) {
      return d.keys().hasOnly(['ownerId', 'dogId', 'dogName', 'breed', 'size', 'markings', 'photoUrl',
                               'microchipped', 'medicines', 'lastSeen', 'city', 'state', 'status', 'createdAt'])
          && d.keys().hasAll(['ownerId', 'dogId', 'dogName', 'status', 'createdAt'])
          && d.ownerId == request.auth.uid
          && d.dogId == request.auth.uid
          && d.status == 'active'
          && d.createdAt == request.time
          && d.dogName is string && d.dogName.size() >= 1 && d.dogName.size() <= 60
          && okStr(d.get('breed', null), 80)
          && okStr(d.get('size', null), 20)
          && okStr(d.get('markings', null), 200)
          && okStr(d.get('photoUrl', null), 1000)
          && okStr(d.get('lastSeen', null), 80)
          && okStr(d.get('city', null), 80)
          && okStr(d.get('state', null), 40)
          && okBool(d.get('microchipped', null))
          && okStrList(d.get('medicines', null), 5, 300);
    }

    // Any signed-in member can read an alert (it is what a push opens); it holds
    // nothing private. The public website reads it through the Admin SDK.
    match /lostAlerts/{alertId} {
      allow read: if isSignedIn();
      // Own dog, and no other active alert: lostActive/{uid} must not exist yet
      // and must be created in the same batch, pointing at this alert.
      allow create: if isRealAccount()
                    && validNewLostAlert(request.resource.data)
                    && exists(/databases/$(database)/documents/dogs/$(request.auth.uid))
                    && !exists(/databases/$(database)/documents/lostActive/$(request.auth.uid))
                    && getAfter(/databases/$(database)/documents/lostActive/$(request.auth.uid)).data.alertId == alertId;
      // The owner may mark it found (status + foundAt only) or update where the dog
      // was last seen. Nothing else changes after creation.
      allow update: if isOwner(resource.data.ownerId)
                    && resource.data.status == 'active'
                    && (
                         (request.resource.data.status == 'found'
                           && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'foundAt'])
                           && request.resource.data.get('foundAt', null) == request.time)
                         || (request.resource.data.status == 'active'
                           && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeen'])
                           && okStr(request.resource.data.get('lastSeen', null), 80))
                       );
      allow delete: if false;

      // Exact pins, finder contact details and photos: the owner only.
      match /sightings/{sightingId} {
        allow read: if isSignedIn()
                    && get(/databases/$(database)/documents/lostAlerts/$(alertId)).data.ownerId == request.auth.uid;
        allow write: if false;
      }
    }

    match /lostActive/{userId} {
      allow read: if isOwner(userId);
      allow create: if isRealAccount() && isOwner(userId)
                    && request.resource.data.keys().hasOnly(['alertId', 'createdAt'])
                    && request.resource.data.alertId is string
                    && request.resource.data.alertId.size() <= 64
                    && request.resource.data.createdAt == request.time
                    && getAfter(/databases/$(database)/documents/lostAlerts/$(request.resource.data.alertId)).data.ownerId == userId
                    && getAfter(/databases/$(database)/documents/lostAlerts/$(request.resource.data.alertId)).data.status == 'active';
      allow update: if false;
      // Only once the alert is marked found (in the same batch), so closing is the
      // only way to be allowed a second alert.
      allow delete: if isOwner(userId)
                    && getAfter(/databases/$(database)/documents/lostAlerts/$(resource.data.alertId)).data.status == 'found';
    }

    // Per-IP and per-alert counters for the public sighting form. Admin SDK only.
    match /lostRate/{key} {
      allow read, write: if false;
    }
    // ══ end LOST DOG ALERT ════════════════════════════════════════════════════
  }
}
