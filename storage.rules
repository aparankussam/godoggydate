rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ── HELPERS ────────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    // Uploading needs a real account: Google or Apple, not an anonymous guest
    // (the iPhone app's guest mode). Guests can't create a dog profile
    // (firestore.rules), so they have no photos to upload, and a throwaway
    // anonymous account shouldn't be able to host files at a public link.
    function isRealAccount() {
      return isSignedIn()
          && request.auth.token.firebase.sign_in_provider in ['google.com', 'apple.com'];
    }

    // An explicit list rather than image/.*, which would admit SVG (scriptable).
    function isPhoto() {
      return request.resource.contentType.matches('image/(jpeg|png|webp|heic|heif)');
    }

    function isUnder10MB() {
      return request.resource.size < 10 * 1024 * 1024;
    }

    function isUnder50MB() {
      return request.resource.size < 50 * 1024 * 1024;
    }

    // ── DOG PHOTOS ────────────────────────────────────────────────────────────
    // Path: dogs/{userId}/{dogId}/photos/{filename}
    match /dogs/{userId}/{dogId}/photos/{filename} {
      allow read:   if isSignedIn();
      allow write:  if isRealAccount()
                    && request.auth.uid == userId
                    && isPhoto()
                    && isUnder10MB();
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    // ── DOG VIDEOS ────────────────────────────────────────────────────────────
    // Path: dogs/{userId}/{dogId}/video/{filename}
    match /dogs/{userId}/{dogId}/video/{filename} {
      allow read:   if isSignedIn();
      allow write:  if isRealAccount()
                    && request.auth.uid == userId
                    && request.resource.contentType.matches('video/.*')
                    && isUnder50MB();
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    // ── USER AVATARS ──────────────────────────────────────────────────────────
    // Path: avatars/{userId}/{filename}
    match /avatars/{userId}/{filename} {
      allow read:   if isSignedIn();
      allow write:  if isRealAccount()
                    && request.auth.uid == userId
                    && isPhoto()
                    && isUnder10MB();
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }
  }
}
