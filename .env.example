# ─────────────────────────────────────────────────────────────
# GoDoggyDate — Environment Variables
# Copy this file to .env.local (web) or .env (mobile/root)
# NEVER commit real keys to version control.
# ─────────────────────────────────────────────────────────────

# ── Firebase ──────────────────────────────────────────────────
# Web (Next.js) — prefix NEXT_PUBLIC_ for client-side access
NEXT_PUBLIC_FIREBASE_API_KEY=firebase_placeholder
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=godoggydate-dev
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=godoggydate-dev.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:placeholder

# Mobile (Expo) — prefix EXPO_PUBLIC_ for client-side access
EXPO_PUBLIC_FIREBASE_API_KEY=firebase_placeholder
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=godoggydate-dev
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=godoggydate-dev.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
EXPO_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:placeholder

# ── Stripe ────────────────────────────────────────────────────
# Web (public — safe to expose in browser)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
# Founding Member $39 lifetime Stripe Payment Link (optional; CTA hidden when unset).
# The app appends ?client_reference_id=<uid> so the webhook can grant the entitlement.
NEXT_PUBLIC_FOUNDING_MEMBER_PAYMENT_LINK=https://buy.stripe.com/replace_me

# Mobile (public — safe to expose in app)
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
EXPO_PUBLIC_PAYMENTS_API_URL=http://localhost:3000
# Optional fallback if mobile should call the main web origin directly
EXPO_PUBLIC_WEB_URL=http://localhost:3000
# Founding Member $39 lifetime Stripe Payment Link — opened via Linking.openURL
# (external browser, never in-app, to stay clear of Apple IAP rules).
EXPO_PUBLIC_FOUNDING_MEMBER_PAYMENT_LINK=https://buy.stripe.com/replace_me
# goDoggyDate Pro checkout buttons (mobile + web). Leave false/unset until the
# Stripe Prices exist: the buttons then say "coming soon" instead of linking to
# a checkout route that 503s. Read as the literal string "true".
EXPO_PUBLIC_PRO_ENABLED=false
NEXT_PUBLIC_PRO_ENABLED=false
# Server-side only: the recurring Stripe Price ids behind /api/stripe/checkout
# (Stripe Dashboard -> Product catalog -> the Pro product -> each price's id,
# "price_..."). Unset -> the checkout route answers 503 and the app hides the
# Pro buttons. Founding Member is NOT sold here, only through its Payment Link.
STRIPE_PRO_PRICE_MONTHLY=price_placeholder_monthly
STRIPE_PRO_PRICE_ANNUAL=price_placeholder_annual

# Server-side only — NEVER expose to client
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# ── Firebase Admin (server/functions only) ────────────────────
FIREBASE_PROJECT_ID=godoggydate-dev
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@example.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Optional. Storage bucket the server uploads to (lost-dog sighting photos). Falls
# back to NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET when unset.
# FIREBASE_STORAGE_BUCKET=godoggydate-dev.appspot.com
# Optional but recommended in production. A random secret mixed into the hash that
# rate-limits the public lost-dog sighting form (web/app/api/lost/sighting). Without
# it the hash is unsalted. Generate one with: openssl rand -hex 32
# LOST_RATE_SALT=
# Point to your service account JSON for local admin SDK usage:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccountKey.json

# ── Google Sign-In (Expo native + browser) ─────────────────────
# Web: OAuth 2.0 Web client id (Google Cloud console -> APIs & Services ->
# Credentials). Enables the Google one-tap / button on the sign-in modal. Public.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=google_web_client_id_placeholder
# Web: show "Continue with Apple" once the Apple provider is configured in the
# Firebase console. Read as the literal string "true"; hidden otherwise.
NEXT_PUBLIC_APPLE_SIGNIN_ENABLED=false
EXPO_PUBLIC_GOOGLE_EXPO_CLIENT_ID=google_expo_client_id_placeholder
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=google_web_client_id_placeholder
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=google_ios_client_id_placeholder
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=google_android_client_id_placeholder

# ── App Config ────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://godoggydate.com
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
GOOGLE_SITE_VERIFICATION=google_site_verification_token
EXPO_PUBLIC_EAS_PROJECT_ID=your-expo-eas-project-id
# EAS alias for the same id; either name works. Leave unset when the line above is set.
# EAS_PROJECT_ID=your-expo-eas-project-id
NODE_ENV=development

# Optional: label for error reports ("release" in the [client-error] log line).
# On Vercel it defaults to the first 7 characters of the git commit, so leave it
# unset there.
# NEXT_PUBLIC_RELEASE=

# LOCAL DEVELOPMENT ONLY - never set this in production. Points the browser app at
# the Firebase emulators (ports from firebase.json). It only takes effect together
# with a Firebase project id that starts with "demo-".
# NEXT_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1

# ── AI features (server-side only: /api/ai/*) ──────────────────
# Google AI Studio API key for the Gemini calls behind Vibe Check, Roast, Apology,
# Texts, Letter and Human Review. Unset -> those routes answer 503 ("not
# configured yet") and the app shows a friendly message. NEVER expose to the client.
GEMINI_API_KEY=gemini_api_key_placeholder
# Optional model id. When unset the routes use gemini-3.6-flash and, except Vibe
# Check, fall back to gemini-flash-latest then gemini-2.5-flash if it 404s.
# GEMINI_MODEL=gemini-3.6-flash
# Optional project-wide ceiling on AI calls per UTC day (default 2000). Only calls
# that really reach the model count; past it every AI feature says it is "resting
# for today". Per-account limits apply on top of this.
# AI_GLOBAL_DAILY_LIMIT=2000

# ── Monitoring ────────────────────────────────────────────────
# Optional Slack- or Discord-compatible https incoming-webhook URL. When set,
# /api/client-error posts a one-line summary of each NEW browser error (at most one
# post a minute per server instance). Unset -> errors are still logged.
# CLIENT_ERROR_WEBHOOK_URL=https://hooks.slack.com/services/replace_me
# Firebase Functions secret (not read from .env): a Slack/Discord webhook for user
# reports and payments that could not be attributed. Set it with
#   firebase functions:secrets:set OPS_ALERT_WEBHOOK_URL
OPS_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/replace_me

# Cloud Functions only (firebase/functions/.env, not the web app): extra Storage
# bucket names, comma-separated, whose photo URLs a profile write may keep. The
# project's own two default buckets are always allowed; set this only if photos live
# in some other bucket, or they are dropped on the next profile save. Optional.
# GDD_PHOTO_BUCKETS=

# ── Operator scripts (scripts/*.cjs; local use only) ───────────
# Point the admin scripts at a project other than "godoggydate" (the local
# emulators, normally) and at a specific Storage bucket. Both optional.
# GDD_PROJECT_ID=demo-godoggydate
# GDD_STORAGE_BUCKET=godoggydate.firebasestorage.app
# scripts/prepare-dev-user.cjs: the Firebase uid to prepare, and whether to create a
# directly unlocked match (1/true/yes) instead of a locked one.
# TEST_USER_ID=
# DIRECT_LOCKED_MATCH=false
# npm run verify:launch-config: set to "true" to also require a real Expo project id,
# as a production build would.
# GODOGGYDATE_VERIFY_PRODUCTION=false

# ── Push notifications + mobile analytics ─────────────────────
# Firebase console → Project settings → Cloud Messaging → Web Push certificates
NEXT_PUBLIC_FIREBASE_VAPID_KEY=web_push_vapid_key_placeholder
# GA4 Admin → Data streams → Measurement Protocol API secrets (server-only!)
GA4_API_SECRET=ga4_api_secret_placeholder
